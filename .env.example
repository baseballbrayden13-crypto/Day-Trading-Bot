# Copy this file to .env and fill in your keys. Never share or commit .env.

# Alpaca paper trading keys: https://app.alpaca.markets  (switch to "Paper" in the top left, then API Keys)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Real money is OFF. To ever turn it on you must set BOTH of these. Don't, until paper results hold up for months.
LIVE_TRADING=false
LIVE_TRADING_CONFIRM=

SYMBOLS=SPY,QQQ,AAPL,MSFT,NVDA
BAR_MINUTES=5

# Strategy: ema_cross (default), orb (opening-range breakout), vwap_reversion, bollinger,
# pdh_break, gap_reversal, vwap_pullback or rsi2. See the table in README.md.
# Compare them all on the same data with:  python -m bot.compare --source alpaca --days 180
STRATEGY=ema_cross
ORB_MINUTES=15
ORB_TARGET_R=2.0
ORB_LAST_ENTRY=             # e.g. 11:30 = no new breakout entries after 11:30am ET. Empty = all day.
ORB_STOP=low                # low = stop at the range low, mid = stop at the middle of the range
ORB_VWAP_FILTER=false       # true = only take breakouts above VWAP
ORB_VOLUME_MULT=0           # e.g. 1.5 = breakout bar needs 1.5x the 20-bar average volume. 0 = off
ORB_MAX_RANGE_PCT=0         # e.g. 1.0 = skip days whose opening range is wider than 1% of price. 0 = off
ORB_GAP=any                 # any, up (only gap-up days) or down (only gap-down days)
GAP_MIN_PCT=1.0             # gap_reversal: how far below yesterday's close it must open, in %
EMA_FAST=9
EMA_SLOW=21
VWAP_REV_ATR=1.5           # vwap_reversion: buy when price is this many ATRs below VWAP...
VWAP_REV_RSI=30            # ...and RSI is under this
BB_PERIOD=20               # bollinger: band length in bars
BB_STD=2.0                 # bollinger: band width in standard deviations
STOP_ATR=1.5
TARGET_ATR=3.0
MARKET_FILTER=              # e.g. SPY: only buy when SPY is above its VWAP. Empty = off.

# Risk
RISK_PER_TRADE=0.005        # lose at most ~0.5% of equity if a stop is hit
MAX_POSITION_PCT=0.20       # one position never more than 20% of equity
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS_PCT=0.02     # stop trading for the day at -2%
MAX_TRADES_PER_DAY=10

# Backtest costs. Alpaca charges no commission, but passes regulatory fees through on every sell.
SLIPPAGE_BPS=2.0            # cost of each fill vs the bar price, in basis points
SEC_FEE_RATE=0.0000278      # SEC fee per $ of sale value (check alpaca.markets/support/regulatory-fees)
TAF_PER_SHARE=0.000195      # FINRA trading activity fee per share sold
TAF_MAX=9.79                # TAF cap per trade

# Optional: have Claude review each trade before it is placed (costs API credits per signal)
AI_REVIEW=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_MIN_CONFIDENCE=0.6
AI_NEWS=true                # show the reviewer the stock's last 24h of Alpaca news headlines (free)
